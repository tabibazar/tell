# wave, built for the radio instead of the sensor pages. See SCREEN_WIFI.
CONFIG_SCREEN_WIFI=y

# PSRAM is what makes this possible at all: the framebuffer moves there and
# leaves internal DMA memory for the radio, which cannot use anything else.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536

# A board that receives a few packets a minute, not a video stream.
# Two, because two is what there is room for. The driver asks for its static
# receive buffers in internal DMA memory and refuses to start if it gets fewer
# than it asked for -- "Expected to init 4 rx buffer, actual is 2" -- so the
# number has to be the honest one rather than the hopeful one.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=2
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=12
CONFIG_ESP_WIFI_TX_BUFFER_TYPE=1
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=12
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
# The driver's NVS copy of the AP config is a cache of something this
# firmware sets explicitly every boot, so it is never read.
CONFIG_ESP_WIFI_NVS_ENABLED=n

# Both radios are the same radio. Without software coexistence WiFi retrying
# an association every few seconds starves BLE advertising, and the board
# stops answering to "tell" -- which is still how it is talked to.
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
