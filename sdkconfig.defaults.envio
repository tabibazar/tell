CONFIG_SCREEN_BOARD_TOUCH_LCD_35B=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-envio.csv"

# 16 MB flash, like lilly, so the base file's 4 MB must be undone.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=n
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Native USB-Serial-JTAG like lilly, so the console settings in
# sdkconfig.defaults are already right and nothing is overridden here.

# PSRAM on, unlike lilly. Her framebuffer was 107 KB and fit internal memory;
# envio's is 320*480*2 = 307 KB and cannot, so it goes to PSRAM. The fingerprint
# read the chip's eFuse as 8 MB AP_3v3, which is octal, so octal mode it is.
# Flash stays quad -- the eFuse says so, and only the PSRAM is octal here.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y

# An environment + weather dashboard, not a games board. ENV_ONLY brings up
# the AHT21 and ENS160 (temp/humidity and the gas sensor) and the room pages,
# and drops everything that is not the clock or a reading. The DS3231 the user
# wired is probed regardless and gives battery-backed time. Weather still
# arrives on the clock page from the Mac; the forecast page is added on top.
CONFIG_SCREEN_ENV_ONLY=y

# No auto-cycling: envio stays on whatever page you leave it, and swipe or tap
# navigates (she has touch). 0 disables the timed rotation; the idle saver only
# drifts the clock. Explicit because the cached sdkconfig keeps a stale value
# otherwise.
CONFIG_SCREEN_ROTATE_SECS=0

# Camera (OV5640 on the 24-pin DVP header). esp32-camera's SCCB control lines
# are GPIO8/7, which ARE I2CBUS_MAIN (i2cbus.c, I2C_NUM_0). The bring-up rides
# that existing new-driver bus: camera_config_t.sccb_i2c_port = 0 with
# pin_sccb_sda/scl = -1, so esp_camera calls SCCB_Use_Port (does not create or,
# on deinit, delete our bus). That REQUIRES the new-driver SCCB backend; the
# legacy driver/i2c backend would abort at boot against our i2c_master bus.
# NEW is the component default but pinned here so a stale cache cannot revert it.
CONFIG_SCCB_HARDWARE_I2C_DRIVER_NEW=y
