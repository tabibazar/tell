<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tabibazar.tell-stats</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/reza/PycharmProjects/esp32-small/tools/push-stats.sh</string>
        <string>big</string>
    </array>

    <key>StartInterval</key>
    <integer>60</integer>

    <key>RunAtLoad</key>
    <true/>

    <!-- Logs, because a launchd job fails silently otherwise. Bluetooth is
         TCC-gated per executable, so a permission denial shows up here. -->
    <key>StandardOutPath</key>
    <string>/tmp/tell-stats.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/tell-stats.err</string>
</dict>
</plist>
