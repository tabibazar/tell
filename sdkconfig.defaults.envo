CONFIG_SCREEN_BOARD_TOUCH_LCD_147=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-envo.csv"

# 16 MB flash, like lilly/wave/envio, so the base file's 4 MB must be undone.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=n
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Native USB-Serial-JTAG like lilly, so the console settings in
# sdkconfig.defaults are already right and nothing is overridden here.

# ESP32-S3R8: 8 MB octal PSRAM. The 320*172*2 = 107 KB framebuffer would fit
# internal memory, but PSRAM keeps internal DMA memory free for the radio, as
# on envio. Octal because the R8 part is octal.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y

# An environment logger: the clock plus temperature/humidity/pressure/VOC
# pages, charted from the flash ring. ENV_ONLY drops everything else -- and
# envo has no IMU, so none of the sensor toys come in regardless.
CONFIG_SCREEN_ENV_ONLY=y

# No auto-cycling: envo stays on whatever page it is left on. 0 disables the
# timed rotation. Explicit because the cached sdkconfig keeps a stale value.
CONFIG_SCREEN_ROTATE_SECS=0

# Altitude correction off by default (0). Reza can set his ~179 m (North
# York/Willowdale) once the board is on his desk, as envio has.
CONFIG_SCREEN_ALTITUDE_M=0

# Long filenames for FATFS: the SD CSV log is named envo/YYYY-MM-DD.csv, whose
# 10-character base name is not an 8.3 short name. Heap-allocated LFN buffers.
CONFIG_FATFS_LFN_HEAP=y

# Low: at 100% the panel and board run hot to the touch, and the heat reaches
# the soldered sensors.
CONFIG_SCREEN_BRIGHTNESS=20

# Idle at 80 MHz instead of spinning at 160 (see app_main); no light sleep.
CONFIG_PM_ENABLE=y
