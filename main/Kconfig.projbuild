menu "Screen board"

choice SCREEN_BOARD
    prompt "Target board"
    default SCREEN_BOARD_FEATHER_S3_TFT
    help
        Selects the display driver. Everything else is board independent.

config SCREEN_BOARD_FEATHER_S3_TFT
    bool "Adafruit Feather ESP32-S3 TFT (ST7789 240x135, SPI)"

config SCREEN_BOARD_CROWPANEL_7
    bool "Elecrow CrowPanel 7.0 HMI (800x480, 16-bit RGB)"

config SCREEN_BOARD_TDISPLAY_S3
    bool "LilyGO T-Display-S3 (ST7789 320x170, 8-bit i80)"

config SCREEN_BOARD_WAVESHARE_147B
    bool "Waveshare ESP32-S3-LCD-1.47B (ST7789 320x172, SPI, onboard IMU)"

endchoice

config SCREEN_DEVICE_NAME
    string "Advertised BLE name"
    default "big" if SCREEN_BOARD_CROWPANEL_7
    default "lilly" if SCREEN_BOARD_TDISPLAY_S3
    default "wave" if SCREEN_BOARD_WAVESHARE_147B
    default "small"
    help
        The name this board advertises. Give each board on your desk a
        distinct name so `tell --device NAME` can pick between them.

config SCREEN_I2C_SDA
    int "I2C SDA pin"
    default 19 if SCREEN_BOARD_CROWPANEL_7
    default 18 if SCREEN_BOARD_TDISPLAY_S3
    default 48 if SCREEN_BOARD_WAVESHARE_147B
    default 42
    help
        The CrowPanel wires its GT911 touch controller to GPIO19/20. The
        Feather's STEMMA QT port is GPIO42/41, from Adafruit's board variant.
        The T-Display-S3 brings its bus out on GPIO18/17. The Waveshare
        1.47B wires its onboard QMI8658 to GPIO48/47.

config SCREEN_I2C_SCL
    int "I2C SCL pin"
    default 20 if SCREEN_BOARD_CROWPANEL_7
    default 17 if SCREEN_BOARD_TDISPLAY_S3
    default 47 if SCREEN_BOARD_WAVESHARE_147B
    default 41

endmenu
