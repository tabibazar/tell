CONFIG_SCREEN_BOARD_TOUCH_LCD_169=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-watch.csv"

# 16 MB flash, so the base file's 4 MB setting must be undone.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=n
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Native USB-Serial-JTAG, so the console settings in sdkconfig.defaults are
# already right and nothing is overridden here.

# ESP32-S3R8: 8 MB octal PSRAM. The 240x280 framebuffer and the face's cached
# dial background (134 KB each) live there, leaving internal DMA memory to the
# radio.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y

# A face that is read at a glance, not a panel left lit on a desk; raised on a
# touch or a raise of the wrist and dark again after 30 s.
CONFIG_SCREEN_BRIGHTNESS=40

# No timed page rotation: the face stays until a button changes it.
CONFIG_SCREEN_ROTATE_SECS=0

# Idle at 80 MHz between the once-a-second redraws (see app_main).
CONFIG_PM_ENABLE=y
