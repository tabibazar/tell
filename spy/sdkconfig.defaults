CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# ESP32-S3R8: 8 MB octal PSRAM. Big buffers live there; internal RAM is the
# limit that bites (camera DMA, lwIP/PPP, the TLS handshake, the encoder).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=2048
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# The encoder holds a core ~1.2 s per frame; the idle task survives that.
CONFIG_ESP_TASK_WDT_TIMEOUT_S=20

# 4G over PPP; TLS to api.telegram.org against the bundled roots.
CONFIG_LWIP_PPP_SUPPORT=y
CONFIG_LWIP_PPP_PAP_SUPPORT=y
CONFIG_LWIP_PPP_CHAP_SUPPORT=y
CONFIG_LWIP_PPP_NOTIFY_PHASE_SUPPORT=y
CONFIG_LWIP_SNTP_MAX_SERVERS=2
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y

# Long file names on the card.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=64

CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Uploads ran at ~14 KB/s with lwIP's default 5.7 KB send window: one window
# per LTE round trip. A bigger window (in PSRAM) keeps the link busy.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64

# The hotspot: WiFi clients NATed out through PPP.
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y
# WiFi on took internal RAM from 255 KB to 135 KB, too little for an hourly
# encode (~90 KB) and a TLS upload (~40 KB) together. WiFi and lwIP code
# stays in flash, not internal RAM, and fewer static receive buffers.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_LWIP_IRAM_OPTIMIZATION=n
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
# A phone on the hotspot fills PPP faster than lwIP drained it ("pppos_input_tcpip
# failed with -1", packets dropped): a deeper queue and a busier tcpip task.
CONFIG_LWIP_TCPIP_TASK_PRIO=20
